# Copy to .env (gitignored) and fill in for local docker compose dev.

LISTEN_ADDR=0.0.0.0:8080
OPENMETEO_BASE_URL=https://map-tiles.open-meteo.com
MAX_CONCURRENT_FETCHES=16
RUST_LOG=info,infoclimat_om_worker=debug

# Cloudflare R2 — S3-compatible
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Generate Access Key ID / Secret in CF dashboard: R2 → Manage R2 API Tokens
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=om-cumul-cache
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public base URL of the R2 bucket — once the bucket has managed public access
# enabled (R2 dashboard → bucket → Settings → Public Access), set this to the
# r2.dev URL (e.g. https://pub-xxxxxxxx.r2.dev) or to a custom domain. When
# set, the worker returns 307 redirects to <R2_PUBLIC_URL>/<key> instead of
# serving OMfile bytes inline. R2 then handles `Range` requests natively,
# which the JS OM file reader requires. Leave unset for curl-based testing
# while developing — the browser client needs this set.
# R2_PUBLIC_URL=
